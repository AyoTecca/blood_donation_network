# Copy to `.env` in this folder and fill in values. Never commit `.env`.
# Oracle Database Free (Docker gvenzl/oracle-free) — container uses ORACLE_PASSWORD.
ORACLE_PASSWORD=REPLACE_WITH_ORACLE_CONTAINER_PASSWORD
ORACLE_USER=SYSTEM
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=FREEPDB1

# SQLAlchemy / Alembic / FastAPI (thin driver — no Instant Client required).
# Must use the same password as ORACLE_PASSWORD (and the same user/host/service).
DATABASE_URL=oracle+oracledb://SYSTEM:REPLACE_WITH_ORACLE_CONTAINER_PASSWORD@localhost:1521/?service_name=FREEPDB1

# JWT — use a long random string; required for the API (no default in code).
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Seeded admin user created by Alembic revision `005_app_users` (required for that migration).
DEV_ADMIN_EMAIL=admin@local.dev
DEV_ADMIN_PASSWORD=REPLACE_WITH_STRONG_DEV_PASSWORD
